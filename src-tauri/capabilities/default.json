{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": ["main", "desktop-icon"],
  "permissions": [
    "core:default",
    "allow-desktop-icon",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://**" }, { "url": "http://**" }]
    },
    "allow-license",
    "allow-db"
  ]
}
